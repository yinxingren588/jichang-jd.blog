---
import Layout from '../layouts/Layout.astro';
import { faqArticles } from '../data/faqArticles';
import { getCollection } from 'astro:content';

const tutorials = await getCollection('tutorials');

// 1. 核心母版页面 TDK 数据
const corePages = [
  {
    type: 'core',
    typeName: '核心母版页',
    url: '/',
    name: '首页精选',
    title: '节点推荐 | 2026 稳定优质高速机场节点选购评测博客 - V机场节点推荐',
    description: 'V机场节点推荐致力于提供专业的节点推荐与网络性能评测。针对外贸办公、ChatGPT/Claude 人工智能交互及 4K 影音流媒体场景，深度实测各主流机场节点的晚高峰稳定性、延迟抖动与解锁能力，帮您挑选不卡顿的高速节点。',
    keywords: '节点推荐, 优质节点推荐, 稳定节点推荐, 机场节点推荐, 高速节点, 科学上网节点, 节点选购, V机场节点推荐',
  },
  {
    type: 'core',
    typeName: '核心母版页',
    url: '/ranking',
    name: '机场测评排行',
    title: '机场推荐 | 2026 优质稳定翻墙机场天梯排行榜与综合对比',
    description: '精选 2026 稳定机场推荐排行榜，基于晚高峰多地实测数据，横向对比 28 家主流机场的专线质量、月付资费、倍率规则与流媒体解锁能力。为您提供客观中立的机场推荐与选购参考，避开跑路套路盘。',
    keywords: '机场推荐, 机场排行榜, 优质机场推荐, 稳定机场, 机场对比, 专线机场推荐, 翻墙机场排名, 机场选购参考',
  },
  {
    type: 'core',
    typeName: '核心母版页',
    url: '/airports/invisible-cloud',
    name: '隐形人（本站主推第1名）专属深度评测',
    title: '隐形人机场测评：60个企业IEPL专线节点晚高峰测速与使用体验',
    description: '深度实测隐形人机场：全量测试 60 个企业级 IEPL 纯专线节点的晚高峰延迟与带宽吞吐。详细分析 VLESS 协议性能、住宅原生 IP 解锁 ChatGPT 与 4K 流媒体实测表现，收录 9 大官方在售套餐明细与最新优惠码。',
    keywords: '机场测评, 隐形人机场测评, 机场评测, 机场测速, IEPL专线评测, 隐形人怎么样, 隐形人节点测速, VLESS专线',
  },
  {
    type: 'core',
    typeName: '核心母版页',
    url: '/speedtest',
    name: '晚高峰测速天梯榜',
    title: '机场测速与晚高峰压力评测天梯榜：28家主流品牌实测数据 - 机场测评',
    description: '2026 最新主流机场测速与晚高峰真实极限压力横向测评。基于千兆光纤实测采样，全景展示 28 家机场的下载速度、网络延迟、抖动幅度与丢包率，拒绝虚假云跑分，呈现真实的晚高峰抗拥塞能力。',
    keywords: '机场测速, 机场测评, 晚高峰测速, 机场跑分, 节点延迟测试, 丢包率对比, 专线测速, 4K测速对比',
  },
  {
    type: 'core',
    typeName: '核心母版页',
    url: '/tutorials',
    name: '全套客户端教程中心',
    title: '客户端配置教程与节点订阅导入全攻略 - V机场节点推荐',
    description: '汇总 Windows、macOS、iOS 与 Android 全平台客户端配置教程。提供 Mihomo Party、Clash Verge Rev、小火箭 Shadowrocket 从软件下载、订阅链接导入到规则分流与 TUN 模式调优的详细图文指引。',
    keywords: '客户端教程, 订阅配置, 节点导入, 科学上网教程, Mihomo教程, Clash教程, 小火箭配置, TUN模式教程',
  },
  {
    type: 'core',
    typeName: '核心母版页',
    url: '/guide',
    name: '选购防踩坑终极指南',
    title: '机场怎么选？2026 机场选购指南与防踩坑全解析',
    description: '专业机场选购指南：通俗解析 IPLC/IEPL 专线与 BGP 中继的物理差异、VLESS 轻量协议优势、ChatGPT 商业住宅 IP 识别方法，传授防跑路四步法则与不同需求人群的科学选购决策树。',
    keywords: '机场选购指南, 机场怎么选, 机场防踩坑, IPLC与IEPL区别, VLESS协议优势, 住宅原生IP选型, 防跑路指南',
  },
  {
    type: 'core',
    typeName: '核心母版页',
    url: '/faq',
    name: '常见问答 FAQ 全集',
    title: '机场常见问题解答与节点故障排查知识库（FAQ 24题）',
    description: '系统解答节点连接与机场使用中的高频疑难杂症：包含假断网快速恢复、节点超时 Timeout 排障、ChatGPT 访问受限解决、节点倍率扣费猫腻识别与退款策略等 24 项实用知识。',
    keywords: '机场常见问题, 节点连接问题, 订阅故障排查, 假断网恢复, 节点超时解决, 科学上网FAQ, ChatGPT报错',
  },
  {
    type: 'core',
    typeName: '核心母版页',
    url: '/disclaimer',
    name: '免责声明与合规告示',
    title: '免责声明与合规使用告知 - V机场节点推荐',
    description: 'V机场节点推荐博客关于内容合规、技术研讨范围、版权保护与免责条款的正式声明。明确本站评测仅供学术科研与跨境商业出海参考。',
    keywords: '免责声明, 网站声明, 合规告示, 服务条款, 版权保护声明',
  },
];

// 2. 24 篇 FAQ 独立精修文章 TDK
const faqPageItems = faqArticles.map((art, idx) => ({
  type: 'faq',
  typeName: `FAQ文章: ${art.categoryName}`,
  url: `/faq/${art.slug}`,
  name: `FAQ #${idx + 1}: ${art.title}`,
  title: art.seoTitle || `${art.title} | 科学上网与机场问答知识库 | V机场节点推荐`,
  description: art.seoDescription || `${art.summary} 本文深入剖析核心技术原理与实操排障步骤。`,
  keywords: art.seoKeywords || `${art.tags.join(', ')}, ${art.categoryName}, 科学上网FAQ, 节点排障, V机场节点推荐`,
}));

// 3. 客户端教程文章 TDK
const tutorialPageItems = tutorials.map((post) => {
  const slug = post.id.replace(/\.(md|mdx)$/, '');
  return {
    type: 'tutorial',
    typeName: '客户端教程',
    url: `/tutorials/${slug}`,
    name: post.data.title,
    title: post.data.seoTitle || `${post.data.title} | V机场节点推荐`,
    description: post.data.seoDescription || post.data.description,
    keywords: post.data.seoKeywords || `${(post.data.tags || []).join(', ')}, ${post.data.category}, 科学上网教程, V机场节点推荐`,
  };
});

// 全站全部 TDK 项目集合
const allTdkItems = [...corePages, ...faqPageItems, ...tutorialPageItems];

// 生成全部纯文本汇总内容方便一键整份复制
const fullTextSummary = allTdkItems.map((item, index) => {
  return `### 【${index + 1}】${item.name} (${item.typeName})
- 页面链接: https://jichang-jd.blog${item.url}
- Title (标题): ${item.title}
- Description (描述): ${item.description}
- Keywords (关键词): ${item.keywords}
`;
}).join('\n');
---

<Layout
  title="V机场节点推荐 全站 Full TDK 一键复制专区 | SEO 规范化管理面板"
  description="收录 V机场节点推荐 (jichang-jd.blog) 全站全部页面的完整 TDK（Title 网页标题、Description 网页描述、Keywords 关键词），支持单项复制与一键整页导出。"
  keywords="Full TDK, SEO TDK复制, 网页标题, 网页描述, 关键词, V机场节点推荐"
>
  <div class="py-10 sm:py-16 font-sans">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
        <a href="/" class="hover:text-indigo-600 transition-colors">首页</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-medium">Full TDK 复制中心</span>
      </nav>

      <!-- 顶部控制横幅 -->
      <header class="p-6 sm:p-10 rounded-3xl bg-gradient-to-br from-indigo-900 via-slate-900 to-indigo-950 text-white shadow-2xl mb-8 border border-indigo-800/60 relative overflow-hidden">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-400/30">
              <span>📋 站长 SEO 快捷工具箱</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight">
              全站 Full TDK 一键复制与管理面板
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              已收录全站共 <strong class="text-amber-400 font-black">{allTdkItems.length}</strong> 个页面的完整 Title、Description 与 Keywords。支持单独复制单条字段，也支持一键整站复制粘贴。
            </p>
          </div>

          <!-- 快速动作按钮 -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
            <button
              id="copy-all-btn"
              type="button"
              class="px-5 py-3 rounded-xl font-black text-xs sm:text-sm text-white bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 active:scale-95 shadow-lg shadow-amber-500/25 transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>一键复制全部 TDK 文本</span>
            </button>

            <a
              href="#raw-textarea"
              class="px-4 py-3 rounded-xl font-bold text-xs sm:text-sm text-slate-200 bg-white/10 hover:bg-white/20 border border-white/20 transition-all text-center"
            >
              直接到底部纯文本框
            </a>
          </div>
        </div>
      </header>

      <!-- Sitemap 与 Bing IndexNow 站长技术工具箱 -->
      <div class="mb-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Sitemap 卡片 -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                XML Sitemap 已就绪
              </span>
              <span class="text-xs text-slate-400">36 个标准 URL</span>
            </div>
            <h3 class="text-sm font-black text-slate-900 dark:text-white mb-1">
              全站 XML 网站地图
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              动态收录 8 个核心母版页、24 篇技术专文与 4 篇教程，内置更新时间与权重。
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center gap-2">
            <a
              href="/sitemap.xml"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline"
            >
              <span>查看 sitemap.xml</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <span class="text-slate-300 dark:text-slate-700">|</span>
            <a
              href="/robots.txt"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300"
            >
              <span>robots.txt</span>
            </a>
          </div>
        </div>

        <!-- Bing IndexNow 密钥验证卡片 -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 border border-sky-200 dark:border-sky-800">
                IndexNow 密钥
              </span>
              <span class="text-xs font-mono text-slate-400">32-bit Hex</span>
            </div>
            <h3 class="text-sm font-black text-slate-900 dark:text-white mb-1">
              Bing 官方验证公钥文件
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-mono truncate" title="edd9dc1f47e9eeac9db1fff660785d10">
              Key: edd9dc1f47e9eeac9db1fff660785d10
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
            <a
              href="/edd9dc1f47e9eeac9db1fff660785d10.txt"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline"
            >
              <span>打开公钥验证文件 (.txt)</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Bing 即时推送指令卡片 -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800">
                即时索引推送已就绪
              </span>
              <span class="text-xs text-slate-400">Bing & IndexNow</span>
            </div>
            <h3 class="text-sm font-black text-slate-900 dark:text-white mb-1">
              终端一键批量推送脚本
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              在终端运行 <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-indigo-600 dark:text-indigo-400">npm run indexnow</code> 即可将全站 36 个最新 URL 批量提交微软必应。
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">✓ 响应 202 Accepted</span>
            <span class="text-[11px] text-slate-400">HTTP/2 POST</span>
          </div>
        </div>
      </div>

      <!-- 实时快筛与检索工具栏 -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 sm:p-5 border border-slate-200 dark:border-slate-800 shadow-sm mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- 分类筛选 Pill -->
        <div class="flex items-center gap-2 flex-wrap text-xs sm:text-sm">
          <span class="text-slate-400 font-bold mr-1">分类：</span>
          <button type="button" class="tdk-filter-btn px-3 py-1.5 rounded-xl font-bold bg-indigo-600 text-white shadow-xs cursor-pointer" data-filter="all">
            全部 ({allTdkItems.length})
          </button>
          <button type="button" class="tdk-filter-btn px-3 py-1.5 rounded-xl font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" data-filter="core">
            核心母版页 ({corePages.length})
          </button>
          <button type="button" class="tdk-filter-btn px-3 py-1.5 rounded-xl font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" data-filter="faq">
            24篇 FAQ 专文 ({faqPageItems.length})
          </button>
          <button type="button" class="tdk-filter-btn px-3 py-1.5 rounded-xl font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" data-filter="tutorial">
            客户端教程 ({tutorialPageItems.length})
          </button>
        </div>

        <!-- 实时搜索输入框 -->
        <div class="relative w-full md:w-72">
          <input
            id="tdk-search-input"
            type="text"
            placeholder="搜索页面名称、路由或关键词..."
            class="w-full pl-9 pr-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- TDK 卡片列表区 -->
      <div id="tdk-list" class="space-y-6">
        {allTdkItems.map((item, idx) => (
          <div
            class="tdk-item bg-white dark:bg-slate-900 rounded-2xl border-2 border-slate-200/90 dark:border-slate-800 p-5 sm:p-6 shadow-sm hover:border-indigo-500/40 transition-all space-y-4"
            data-type={item.type}
            data-search={`${item.name} ${item.url} ${item.title} ${item.keywords}`.toLowerCase()}
          >
            <!-- 头部：序号、页面名、路由与整卡复制按钮 -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-slate-800">
              <div class="flex items-center gap-2.5 flex-wrap">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 font-black text-xs">
                  #{idx + 1}
                </span>
                <h3 class="font-black text-base sm:text-lg text-slate-900 dark:text-white">
                  {item.name}
                </h3>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  {item.typeName}
                </span>
                <a
                  href={item.url}
                  target="_blank"
                  class="text-xs font-mono text-indigo-600 dark:text-indigo-400 hover:underline bg-indigo-50 dark:bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-200/60 dark:border-indigo-800/60"
                >
                  {item.url} &nearr;
                </a>
              </div>

              <!-- 复制单页完整 TDK -->
              <button
                type="button"
                class="copy-single-page-btn self-start sm:self-auto px-3 py-1.5 rounded-xl text-xs font-bold bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950 dark:hover:bg-indigo-900 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800 transition-all cursor-pointer flex items-center gap-1.5"
                data-text={`【${item.name}】\nURL: https://jichang-jd.blog${item.url}\nTitle: ${item.title}\nDescription: ${item.description}\nKeywords: ${item.keywords}`}
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>复制本页完整 TDK</span>
              </button>
            </div>

            <!-- Title 区域 -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                  <span class="font-extrabold text-indigo-600 dark:text-indigo-400">T (Title 网页标题)</span>
                  <span class="text-slate-400">({item.title.length} 字符)</span>
                </div>
                <button
                  type="button"
                  class="copy-btn text-xs font-bold text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 cursor-pointer flex items-center gap-1"
                  data-copy={item.title}
                >
                  <span>复制标题</span>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800 text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 select-all">
                {item.title}
              </div>
            </div>

            <!-- Description 区域 -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                  <span class="font-extrabold text-emerald-600 dark:text-emerald-400">D (Description 网页描述)</span>
                  <span class="text-slate-400">({item.description.length} 字符)</span>
                </div>
                <button
                  type="button"
                  class="copy-btn text-xs font-bold text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 cursor-pointer flex items-center gap-1"
                  data-copy={item.description}
                >
                  <span>复制描述</span>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed select-all">
                {item.description}
              </div>
            </div>

            <!-- Keywords 区域 -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                  <span class="font-extrabold text-amber-600 dark:text-amber-400">K (Keywords 关键词)</span>
                </div>
                <button
                  type="button"
                  class="copy-btn text-xs font-bold text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 cursor-pointer flex items-center gap-1"
                  data-copy={item.keywords}
                >
                  <span>复制关键词</span>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 select-all font-mono">
                {item.keywords}
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- 底部整份纯文本快速复制大文本框 -->
      <section id="raw-textarea" class="mt-16 p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border-2 border-indigo-200 dark:border-indigo-800 shadow-xl space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-black text-slate-900 dark:text-white flex items-center gap-2">
              <span>📝</span>
              <span>全站整份纯文本 Markdown 预览（点击直接一键全选复制）</span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">方便批量粘贴到 Excel、Notion 或交接文档中存档管理</p>
          </div>
          <button
            id="copy-raw-textarea-btn"
            type="button"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-black bg-indigo-600 hover:bg-indigo-700 text-white transition-all active:scale-95 cursor-pointer shrink-0"
          >
            📋 一键全选并复制整篇文本
          </button>
        </div>

        <textarea
          id="raw-text-content"
          readonly
          rows="18"
          class="w-full p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 font-mono text-xs text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 leading-relaxed"
        >{fullTextSummary}</textarea>
      </section>

    </div>
  </div>
</Layout>

<script>
  // 1. 单项复制与单页复制功能
  const copyButtons = document.querySelectorAll('.copy-btn');
  const copySinglePageButtons = document.querySelectorAll('.copy-single-page-btn');
  const copyAllBtn = document.getElementById('copy-all-btn');
  const copyRawBtn = document.getElementById('copy-raw-textarea-btn');
  const rawTextarea = document.getElementById('raw-text-content') as HTMLTextAreaElement | null;

  function copyTextToClipboard(text: string, successMsg = '已成功复制到剪贴板！') {
    navigator.clipboard.writeText(text).then(() => {
      // 触发全局 Toast 提示
      window.dispatchEvent(new CustomEvent('show-toast', {
        detail: {
          title: '复制成功',
          message: successMsg,
          type: 'success',
        }
      }));
    });
  }

  copyButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy') || '';
      copyTextToClipboard(text, '已复制当前字段');
    });
  });

  copySinglePageButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-text') || '';
      copyTextToClipboard(text, '已复制该页完整 TDK');
    });
  });

  copyAllBtn?.addEventListener('click', () => {
    if (rawTextarea) {
      copyTextToClipboard(rawTextarea.value, '已复制全站完整 TDK 大纲！');
    }
  });

  copyRawBtn?.addEventListener('click', () => {
    if (rawTextarea) {
      rawTextarea.select();
      copyTextToClipboard(rawTextarea.value, '已全选并复制全部 TDK 文本！');
    }
  });

  // 2. 实时搜索与分类过滤
  const filterBtns = document.querySelectorAll('.tdk-filter-btn');
  const searchInput = document.getElementById('tdk-search-input') as HTMLInputElement | null;
  const items = document.querySelectorAll('.tdk-item') as NodeListOf<HTMLElement>;

  let currentCategory = 'all';
  let currentSearch = '';

  function doFilter() {
    items.forEach((item) => {
      const type = item.getAttribute('data-type') || '';
      const text = item.getAttribute('data-search') || '';

      const matchCat = currentCategory === 'all' || type === currentCategory;
      const matchSearch = !currentSearch || text.includes(currentSearch);

      if (matchCat && matchSearch) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'all';
      currentCategory = filter;

      filterBtns.forEach((b) => {
        b.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs');
        b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
      });
      btn.classList.add('bg-indigo-600', 'text-white', 'shadow-xs');
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');

      doFilter();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
    doFilter();
  });
</script>
