  <!-- 客户端交互脚本（配套过滤、节点过滤、搜索与优惠券复制） -->
  <script>
    // 1. 配套分类切换交互
    const planTabBtns = document.querySelectorAll('.plan-tab-btn');
    const planCards = document.querySelectorAll('.plan-card');

    planTabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');

        planTabBtns.forEach((b) => {
          b.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs', 'font-bold');
          b.classList.add('text-slate-600', 'dark:text-slate-300', 'font-medium');
        });
        btn.classList.remove('text-slate-600', 'dark:text-slate-300', 'font-medium');
        btn.classList.add('bg-indigo-600', 'text-white', 'shadow-xs', 'font-bold');

        planCards.forEach((card) => {
          const cat = card.getAttribute('data-cat');
          if (target === 'all' || cat === target) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 2. 60 节点地区切换与搜索交互
    const nodeTabBtns = document.querySelectorAll('.node-tab-btn');
    const nodeCards = document.querySelectorAll('.node-card');
    const nodeSearchInput = document.getElementById('node-search-input') as HTMLInputElement | null;
    const noNodesHint = document.getElementById('no-nodes-hint');

    let currentRegion = 'all';
    let currentSearch = '';

    function filterNodes() {
      let visibleCount = 0;
      nodeCards.forEach((card) => {
        const region = card.getAttribute('data-region') || '';
        const name = card.getAttribute('data-name') || '';

        const matchRegion = currentRegion === 'all' || region === currentRegion;
        const matchSearch = !currentSearch || name.includes(currentSearch);

        if (matchRegion && matchSearch) {
          (card as HTMLElement).style.display = 'block';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (noNodesHint) {
        noNodesHint.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    nodeTabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentRegion = btn.getAttribute('data-region') || 'all';

        nodeTabBtns.forEach((b) => {
          b.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs', 'font-bold');
          b.classList.add('text-slate-600', 'dark:text-slate-300', 'bg-slate-100', 'dark:bg-slate-800', 'font-medium');
        });
        btn.classList.remove('text-slate-600', 'dark:text-slate-300', 'bg-slate-100', 'dark:bg-slate-800', 'font-medium');
        btn.classList.add('bg-indigo-600', 'text-white', 'shadow-xs', 'font-bold');

        filterNodes();
      });
    });

    if (nodeSearchInput) {
      nodeSearchInput.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterNodes();
      });
    }

    // 3. 优惠券一键复制逻辑
    const copyBtns = document.querySelectorAll('.copy-coupon-btn');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const coupon = btn.getAttribute('data-coupon') || 'yxr888';
        try {
          await navigator.clipboard.writeText(coupon);
          const originalText = btn.textContent;
          btn.textContent = '✓ 复制成功';
          (btn as HTMLElement).style.backgroundColor = '#10b981';
          (btn as HTMLElement).style.color = '#ffffff';
          setTimeout(() => {
            btn.textContent = originalText;
            (btn as HTMLElement).style.backgroundColor = '';
            (btn as HTMLElement).style.color = '';
          }, 2000);
        } catch (err) {
          prompt('请复制优惠券码：', coupon);
        }
      });
    });
  </script>
