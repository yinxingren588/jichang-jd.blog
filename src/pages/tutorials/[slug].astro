---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { airportsData } from '../../data/airports';

export async function getStaticPaths() {
  const posts = await getCollection('tutorials');
  return posts.map((post) => {
    const slug = post.id.replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

// Pick top 2 recommended airports for the in-article conversion card
const topAirports = airportsData.slice(0, 2);

// 判断是否为测速横评或宽屏长表格页面，提供大气宽屏布局与右侧浮窗安全边距
const isWideLayout = post.id.includes('speedtest') || post.data.title.includes('测速');
---

<Layout
  title={post.data.seoTitle || `${post.data.title} | V机场节点推荐`}
  description={post.data.seoDescription || post.data.description}
  keywords={post.data.seoKeywords || `${(post.data.tags || []).join(', ')}, ${post.data.category}, 科学上网教程, V机场节点推荐`}
>
  <article class="py-8 sm:py-14">
    <div class={`${isWideLayout ? 'max-w-[1560px] 2xl:max-w-[1680px] xl:pr-64 2xl:pr-72' : 'max-w-4xl'} mx-auto px-4 sm:px-6 lg:px-8 transition-all`}>
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
        <a href="/" class="hover:text-indigo-600">首页</a>
        <span>/</span>
        <a href="/tutorials" class="hover:text-indigo-600">教程中心</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-medium truncate max-w-xs">{post.data.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2 text-xs text-slate-400 mb-4 flex-wrap">
          <span class="px-2.5 py-1 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-bold border border-indigo-200/60 dark:border-indigo-800/60">
            {post.data.category}
          </span>
          {post.data.platform && (
            <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
              适用平台: {post.data.platform}
            </span>
          )}
          <span>发布时间: {post.data.pubDate}</span>
          <span>•</span>
          <span>作者: {post.data.author}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
          {post.data.title}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 mt-4 leading-relaxed bg-slate-50 dark:bg-slate-900/60 p-4 rounded-xl border border-slate-200/60 dark:border-slate-800">
          💡 <strong>核心导读：</strong>{post.data.description}
        </p>
      </header>

      <!-- Markdown Prose Content -->
      <div class="article-content max-w-none text-slate-700 dark:text-slate-300 leading-relaxed text-sm sm:text-base">
        <Content />
      </div>

<style is:global>
  /* Markdown 文章排版与框架化样式优化 */
  .article-content h1,
  .article-content h2,
  .article-content h3,
  .article-content h4 {
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #0f172a;
  }
  .dark .article-content h1,
  .dark .article-content h2,
  .dark .article-content h3,
  .dark .article-content h4 {
    color: #f8fafc;
  }
  .article-content h2 {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .dark .article-content h2 {
    border-bottom-color: #1e293b;
  }
  .article-content h3 {
    font-size: 1.25rem;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .article-content p {
    margin-top: 1rem;
    margin-bottom: 1rem;
    line-height: 1.8;
  }
  .article-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .article-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .article-content li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .article-content hr {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    border-color: #e2e8f0;
  }
  .dark .article-content hr {
    border-color: #1e293b;
  }

  /* 表格框架化外观：圆角外框、表头渐变、行高光与阴影 */
  .article-content table {
    width: 100%;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
    border-collapse: separate;
    border-spacing: 0;
    border: 2px solid #e2e8f0;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
    background-color: #ffffff;
  }
  .dark .article-content table {
    border-color: #334155;
    background-color: #0f172a;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.3);
  }
  .article-content th {
    background: linear-gradient(to right, #f8fafc, #f1f5f9);
    padding: 0.875rem 1rem;
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #334155;
    border-bottom: 2px solid #e2e8f0;
    text-align: left;
  }
  .dark .article-content th {
    background: linear-gradient(to right, #1e293b, #0f172a);
    color: #e2e8f0;
    border-bottom-color: #334155;
  }
  .article-content td {
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    color: #475569;
    border-bottom: 1px solid #f1f5f9;
  }
  .dark .article-content td {
    color: #cbd5e1;
    border-bottom-color: #1e293b;
  }
  .article-content tr:last-child td {
    border-bottom: none;
  }
  .article-content tr:hover td {
    background-color: #f8fafc;
  }
  .dark .article-content tr:hover td {
    background-color: #1e293b50;
  }
  .article-content code {
    font-family: monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    background-color: #f1f5f9;
    color: #4f46e5;
    border: 1px solid #e2e8f0;
  }
  .dark .article-content code {
    background-color: #1e293b;
    color: #818cf8;
    border-color: #334155;
  }
</style>

      <!-- In-Article Affiliate Conversion Box -->
      <section class="mt-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-indigo-50 via-white to-sky-50 dark:from-slate-900 dark:via-slate-900 dark:to-indigo-950/40 border-2 border-indigo-200 dark:border-indigo-800 shadow-md">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
            还没有稳定好用的节点？实测高可用专线推荐
          </h3>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-6">
          有了客户端，还需要一条晚高峰稳定不卡顿、100%不过防火墙的 IPLC 专线。以下是本站长期实测晚高峰跑分最高的优质机场：
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {topAirports.map((airport) => (
            <div class="bg-white dark:bg-slate-800/80 rounded-xl p-4 border border-slate-200 dark:border-slate-700 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-extrabold text-sm text-slate-900 dark:text-white">{airport.name}</span>
                  <span class="text-xs font-bold text-rose-600">¥{airport.price}{airport.billingCycle}</span>
                </div>
                <p class="text-xs text-slate-500 line-clamp-2 mb-3">{airport.slogan}</p>
                <div class="text-[11px] text-amber-600 dark:text-amber-400 font-medium mb-3">
                  优惠码: <code class="font-bold bg-amber-50 dark:bg-amber-950 px-1 py-0.5 rounded">{airport.couponCode}</code> ({airport.discount})
                </div>
              </div>
              <a
                href={airport.affUrl}
                target="_blank"
                rel="noopener noreferrer nofollow sponsored"
                class="w-full py-2 text-center text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-all"
              >
                前往开通体验 &rarr;
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- Back Button -->
      <div class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
        <a
          href="/tutorials"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-600 dark:text-slate-400 hover:text-indigo-600 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>返回全部教程</span>
        </a>
        <a
          href="/ranking"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"
        >
          <span>查看全部机场天梯榜 &rarr;</span>
        </a>
      </div>
    </div>
  </article>
</Layout>
