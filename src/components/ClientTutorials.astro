---
import { clientsData } from '../data/clients';

const platformIcons: Record<string, string> = {
  Windows: 'M3 5.5l7-1v7H3V5.5zm8-1.2l10-1.5v8.7h-10V4.3zM3 12.5h7v7l-7-1v-6zm8 0h10v8.7l-10-1.5v-7.2z',
  iOS: 'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.4c.59-.72.99-1.72.88-2.72-.85.03-1.89.57-2.5 1.28-.54.63-.98 1.63-.86 2.62.95.07 1.89-.46 2.48-1.18z',
  Android: 'M17.523 15.34c-.551 0-.998-.446-.998-.997s.447-.997.998-.997c.55 0 .997.446.997.997s-.447.997-.997.997m-11.046 0c-.551 0-.998-.446-.998-.997s.447-.997.998-.997c.55 0 .997.446.997.997s-.446.997-.997.997m11.405-6.02l1.997-3.46a.416.416 0 00-.152-.567.416.416 0 00-.568.152l-2.023 3.504A12.18 12.18 0 0012 8.01c-1.815 0-3.513.39-5.136 1.053L4.84 5.56a.416.416 0 00-.567-.152.416.416 0 00-.152.567l1.997 3.46C2.688 11.286.343 14.82.016 19h23.968c-.327-4.18-2.672-7.714-6.104-9.68',
};
---

<section id="tutorials" class="py-12 sm:py-16 bg-slate-100/60 dark:bg-slate-900/50 border-y border-slate-200/80 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 border border-sky-200/80 dark:border-sky-800 mb-2">
          <span>📱 全平台客户端中心</span>
        </div>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          主流翻墙客户端与新手配置教学
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 max-w-2xl">
          无论是 Windows、Mac、iPhone 还是安卓，挑选适合您的客户端并根据图文教程完成「一键订阅导入」，3分钟即可畅享极速网络。
        </p>
      </div>
      <a
        href="/tutorials"
        class="inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 group shrink-0"
      >
        <span>浏览全部教程目录</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Client Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {clientsData.map((client) => (
        <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <!-- Platform & Difficulty -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-1.5 text-xs font-bold text-slate-700 dark:text-slate-300">
                <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                <span>{client.platform}</span>
                <span class="text-slate-400 font-normal">| {client.version}</span>
              </div>
              <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60">
                {client.difficulty}
              </span>
            </div>

            <!-- Name -->
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
              {client.name}
            </h3>

            <!-- Feature info -->
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
              {client.coreFeature}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-5">
              {client.tags.map((tag) => (
                <span class="text-[10px] font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                  #{tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Actions -->
          <div class="grid grid-cols-2 gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
            <a
              href={`/tutorials/${client.guideSlug}`}
              class="inline-flex items-center justify-center px-3 py-2 rounded-xl text-xs font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 hover:bg-indigo-100 dark:hover:bg-indigo-900/40 transition-colors"
            >
              图文配置教程
            </a>
            <a
              href={client.downloadUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center justify-center gap-1 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
            >
              <span>官网下载</span>
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
