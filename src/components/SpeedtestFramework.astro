<script>
  // 测速框架内实时快筛逻辑
  const filterBtns = document.querySelectorAll('.st-filter-btn');
  const rows = document.querySelectorAll('.st-row');
  const counter = document.getElementById('st-counter');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // 切换按钮高亮
      filterBtns.forEach((b) => {
        b.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs');
        b.classList.add('text-slate-600', 'dark:text-slate-300');
      });
      btn.classList.add('bg-indigo-600', 'text-white', 'shadow-xs');
      btn.classList.remove('text-slate-600', 'dark:text-slate-300');

      // 过滤行并更新计数
      let visibleCount = 0;
      rows.forEach((row) => {
        const cat = row.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (row as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });

      if (counter) {
        counter.textContent = String(visibleCount);
      }
    });
  });
</script>
