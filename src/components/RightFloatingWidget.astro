---
// RightFloatingWidget.astro - 右侧直接打开的可移动专属推荐与页面导航面板
import { airportsData } from '../data/airports';

// 仅保留独家主推品牌：隐形人
const heroAirport = airportsData.find((a) => a.id === 'invisible-cloud') || airportsData[0];

// 渠道其他页面的专业导航列表（全部对应独立页面）
const pageChannels = [
  { label: '机场综合排行榜', href: '/ranking', icon: '🏆', badge: '精选' },
  { label: '客户端全套教程', href: '/tutorials', icon: '📖', badge: '小白必备' },
  { label: '晚高峰测速天梯', href: '/speedtest', icon: '⚡', badge: '真机跑分' },
  { label: '选购防踩坑指南', href: '/guide', icon: '💡', badge: '必读' },
  { label: '常见问答 FAQ', href: '/faq', icon: '❓', badge: '24题全' },
  { label: '免责声明与合规', href: '/disclaimer', icon: '🛡️', badge: '' },
];
---

<!-- Floating Widget Container (直接打开，默认展开) -->
<aside
  id="right-floating-widget"
  class="fixed right-3 top-20 sm:top-24 z-40 font-sans transition-all duration-300 select-none"
  data-open="true"
  aria-label="右侧专属推荐与页面导航"
>
  <!-- 1. 展开的主面板 (默认直接展示，紧凑小巧，专享独立侧边空间) -->
  <div
    id="rf-panel"
    class="flex flex-col w-[232px] bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl border-2 border-indigo-500/50 dark:border-indigo-500/50 shadow-2xl overflow-hidden text-slate-800 dark:text-slate-100"
  >
    <!-- 拖动手柄与控制栏 -->
    <div
      id="rf-handle"
      class="flex items-center justify-between px-3 py-2 bg-gradient-to-r from-indigo-50 to-slate-50 dark:from-slate-800 dark:to-slate-800/80 border-b border-indigo-100 dark:border-slate-800 cursor-grab active:cursor-grabbing select-none"
      title="按住鼠标左键可拖动此窗口至屏幕任意位置"
    >
      <div class="flex items-center gap-1.5 text-xs font-black text-slate-800 dark:text-slate-200">
        <svg class="w-3.5 h-3.5 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8h16M4 16h16" />
        </svg>
        <span>快捷页面导航</span>
      </div>

      <div class="flex items-center gap-1">
        <!-- 复位按钮 -->
        <button
          id="rf-reset-btn"
          type="button"
          class="p-1 rounded text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors cursor-pointer"
          title="复位至右上角默认位置"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>
        <!-- 最小化按钮 -->
        <button
          id="rf-close-btn"
          type="button"
          class="p-1 rounded text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors cursor-pointer"
          title="最小化收起"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 主体内容 -->
    <div class="p-3 space-y-3 text-xs">
      <!-- 👑 最上面：仅留主推【隐形人】品牌 -->
      <div class="p-2.5 rounded-xl bg-gradient-to-br from-indigo-50 via-indigo-50/40 to-sky-50 dark:from-slate-800 dark:via-slate-800/90 dark:to-indigo-950/60 border border-indigo-200/90 dark:border-indigo-700/80 shadow-sm space-y-2">
        <div class="flex items-center justify-between">
          <span class="inline-flex items-center gap-1 text-[10px] font-black text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/60 px-1.5 py-0.5 rounded border border-amber-300 dark:border-amber-700">
            👑 独家主推
          </span>
          <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400">IEPL 纯专线</span>
        </div>

        <div class="flex items-center gap-2">
          <div class="w-10 h-10 rounded-xl bg-white p-0.5 border-2 border-amber-300 dark:border-amber-700 shrink-0 overflow-hidden shadow-xs flex items-center justify-center">
            <img src="/images/yinxingren-logo.jpg" alt="隐形人" class="w-full h-full object-contain rounded-lg" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between">
              <h4 class="text-sm font-black text-slate-900 dark:text-white truncate">{heroAirport.name}</h4>
              <span class="text-xs font-black text-rose-600 dark:text-rose-400 shrink-0">¥{heroAirport.price}</span>
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight truncate">
              白银档 144GB · 晚高峰 152 MB/s
            </p>
          </div>
        </div>

        <!-- 专属优惠码一键复制 -->
        {heroAirport.couponCode && (
          <div class="flex items-center justify-between p-1 rounded-lg bg-amber-100/60 dark:bg-amber-950/50 border border-dashed border-amber-300 dark:border-amber-700 text-[10px]">
            <span class="font-bold text-slate-800 dark:text-slate-200">码: <code>{heroAirport.couponCode}</code></span>
            <button
              type="button"
              class="copy-coupon-btn px-1.5 py-0.5 rounded bg-amber-500 text-white font-bold text-[9px] hover:bg-amber-600 active:scale-95 transition-all cursor-pointer"
              data-coupon={heroAirport.couponCode}
              data-discount={heroAirport.discount}
              data-name={heroAirport.name}
            >
              复制
            </button>
          </div>
        )}

        <!-- 直达开通按钮 -->
        <a
          href={heroAirport.affUrl}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="w-full inline-flex items-center justify-center gap-1 py-1.5 px-2 rounded-lg font-bold text-[11px] text-white bg-indigo-600 hover:bg-indigo-700 active:scale-95 shadow-sm shadow-indigo-600/30 transition-all text-center"
        >
          <span>直达官网开通</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- 本站主推第一详情入口 -->
        <a
          href="/airports/invisible-cloud"
          class="block text-center text-[10px] text-indigo-600 dark:text-indigo-400 hover:underline font-bold pt-0.5"
        >
          本站主推第一详情页面 &rarr;
        </a>
      </div>

      <!-- 🧭 渠道其他页面的快速导航（只保留内部页面跳转，不放任何其他品牌） -->
      <div class="space-y-1">
        <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block px-1">
          渠道其他页面
        </span>
        <nav class="space-y-0.5">
          {pageChannels.map((item) => (
            <a
              href={item.href}
              class="flex items-center justify-between px-2 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors text-xs"
            >
              <span class="flex items-center gap-1.5">
                <span class="text-xs">{item.icon}</span>
                <span>{item.label}</span>
              </span>
              {item.badge && (
                <span class="text-[9px] text-indigo-600 dark:text-indigo-400 bg-indigo-100/60 dark:bg-indigo-950/60 px-1 py-0.2 rounded font-semibold">
                  {item.badge}
                </span>
              )}
            </a>
          ))}
        </nav>
      </div>

      <!-- 一键回到顶部按钮 -->
      <div class="pt-1 border-t border-slate-100 dark:border-slate-800">
        <button
          id="rf-back-to-top"
          type="button"
          class="w-full py-1 px-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-center text-[10px] font-semibold text-slate-600 dark:text-slate-400 transition-colors flex items-center justify-center gap-1 cursor-pointer"
        >
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
          <span>回到页面顶部</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 2. 最小化备用按钮（仅在点击✕时临时显示） -->
  <button
    id="rf-launcher"
    type="button"
    class="hidden items-center gap-1.5 py-2 px-3 rounded-l-2xl bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white shadow-xl shadow-indigo-600/30 active:scale-95 transition-all cursor-pointer border-y-2 border-l-2 border-white dark:border-slate-800 select-none"
    title="点击重新展开"
  >
    <span class="w-6 h-6 rounded-full bg-white text-indigo-600 font-black text-xs flex items-center justify-center shrink-0 shadow-sm">
      👑
    </span>
    <div class="text-left leading-tight pr-0.5">
      <span class="block text-xs font-black tracking-tight">主推隐形人</span>
      <span class="block text-[9px] text-indigo-200">展开导航 ‹</span>
    </div>
  </button>
</aside>

<script>
  // 右侧可移动浮窗控制器（默认直接打开！）
  const root = document.getElementById('right-floating-widget');
  const panel = document.getElementById('rf-panel');
  const launcher = document.getElementById('rf-launcher');
  const handle = document.getElementById('rf-handle');
  const closeBtn = document.getElementById('rf-close-btn');
  const resetBtn = document.getElementById('rf-reset-btn');
  const backToTopBtn = document.getElementById('rf-back-to-top');

  if (root && panel && launcher && handle) {
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;

    // 默认直接打开！不需要用户特地点击展开
    setOpen(true);

    function setOpen(open: boolean) {
      if (open) {
        panel.classList.remove('hidden');
        panel.classList.add('flex');
        launcher.classList.add('hidden');
        launcher.classList.remove('flex');
        root.dataset.open = 'true';
      } else {
        panel.classList.add('hidden');
        panel.classList.remove('flex');
        launcher.classList.remove('hidden');
        launcher.classList.add('flex');
        root.dataset.open = 'false';
      }
    }

    // 点击收起或重新展开
    launcher.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(false);
    });

    // 一键回到顶部
    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // 复位按钮
    resetBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      root.style.removeProperty('left');
      root.style.removeProperty('top');
      root.style.removeProperty('bottom');
      root.style.right = '0.75rem';
    });

    // 自由拖拽逻辑
    handle.addEventListener('pointerdown', (e: PointerEvent) => {
      if ((e.target as HTMLElement).closest('button, a')) return;

      isDragging = true;
      const rect = root.getBoundingClientRect();
      startX = e.clientX;
      startY = e.clientY;
      initialLeft = rect.left;
      initialTop = rect.top;

      handle.setPointerCapture(e.pointerId);
      e.preventDefault();
    });

    handle.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDragging) return;

      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;

      let newLeft = initialLeft + deltaX;
      let newTop = initialTop + deltaY;

      const rect = root.getBoundingClientRect();
      const maxLeft = window.innerWidth - rect.width - 8;
      const maxTop = window.innerHeight - rect.height - 8;

      newLeft = Math.max(8, Math.min(newLeft, maxLeft));
      newTop = Math.max(8, Math.min(newTop, maxTop));

      root.style.right = 'auto';
      root.style.left = `${newLeft}px`;
      root.style.top = `${newTop}px`;
    });

    const stopDragging = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      try {
        if (handle.hasPointerCapture(e.pointerId)) {
          handle.releasePointerCapture(e.pointerId);
        }
      } catch (err) {}
    };

    handle.addEventListener('pointerup', stopDragging);
    handle.addEventListener('pointercancel', stopDragging);
  }
</script>
