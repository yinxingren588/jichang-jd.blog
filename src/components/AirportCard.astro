---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
  index: number;
  isHero?: boolean;
}

const { airport, index, isHero = airport.id === 'invisible-cloud' } = Astro.props;

// Badge colors
const badgeStyles = {
  amber: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20',
  emerald: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
  purple: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20',
  indigo: 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20',
  rose: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20',
};

const currentBadgeStyle = airport.badgeColor ? badgeStyles[airport.badgeColor] : badgeStyles.indigo;
---

{isHero ? (
  <!-- HERO FIRST-ROW FULL-WIDTH CARD (隐形人专属首排置顶框架) -->
  <div
    class="airport-card group relative col-span-full bg-gradient-to-br from-indigo-50/70 via-white to-sky-50/60 dark:from-slate-900 dark:via-slate-900/90 dark:to-indigo-950/40 rounded-3xl p-6 sm:p-8 lg:p-10 border-2 border-indigo-500/50 dark:border-indigo-500/50 shadow-xl hover:shadow-2xl hover:border-indigo-600 dark:hover:border-indigo-400 transition-all duration-300 ring-4 ring-indigo-500/10 mb-2"
    data-line={airport.lineType}
    data-price={airport.price}
    data-tags={JSON.stringify(airport.tags)}
  >
    <!-- Top Spotlight Tag -->
    <div class="flex items-center justify-between gap-3 mb-6 flex-wrap pb-4 border-b border-indigo-100 dark:border-slate-800">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-amber-500 text-white shadow-sm">
          <span>👑 官方年度全网置顶推荐</span>
        </span>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-600 text-white shadow-sm">
          第一排独占旗舰
        </span>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
          {airport.lineType}
        </span>
      </div>

      <div class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
        <div class="flex text-amber-400 text-base">
          {'★'.repeat(Math.floor(airport.rating))}
        </div>
        <span class="font-black text-slate-900 dark:text-white">{airport.rating}</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">({airport.reviewCount}+ 用户高分好评)</span>
      </div>
    </div>

    <!-- Main Hero Body Grid (Desktop 2 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left side: Info & Streaming (Col 7) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white dark:bg-slate-800 p-1.5 shadow-md border-2 border-amber-400 shrink-0 overflow-hidden flex items-center justify-center">
            <img src="/images/yinxingren-logo.jpg" alt="隐形人 Logo" class="w-full h-full object-contain rounded-xl" />
          </div>
          <div>
            <h3 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-3 flex-wrap">
              <span>{airport.name}</span>
              <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                企业级 IEPL 纯专线 · 极低抖动标杆
              </span>
            </h3>
            <p class="text-base text-slate-700 dark:text-slate-300 mt-1 font-medium leading-relaxed">
              {airport.slogan}
            </p>
          </div>
        </div>

        <!-- Pros bullet list -->
        <div class="space-y-1.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300 pt-1">
          {airport.pros.map((pro) => (
            <div class="flex items-start gap-2">
              <div class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>{pro}</span>
            </div>
          ))}
        </div>

        <!-- Streaming Unlocks -->
        <div class="pt-2">
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400 block mb-2 uppercase tracking-wider">原生流媒体与AI生产力全解锁：</span>
          <div class="flex flex-wrap gap-2">
            {airport.streaming.map((item) => (
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 border border-indigo-200/80 dark:border-indigo-800 shadow-sm">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right side: Specs, Price, Coupon & Action Buttons (Col 5) -->
      <div class="lg:col-span-5 bg-white dark:bg-slate-800/90 rounded-2xl p-6 border border-indigo-100 dark:border-slate-700 shadow-md space-y-4">
        <!-- Specs Bar (4-Grid) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-100 dark:border-slate-800 text-center text-xs">
          <div>
            <span class="text-slate-400 block text-[10px] mb-0.5">白银入门档</span>
            <span class="font-extrabold text-slate-800 dark:text-slate-100">144 GB/月</span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] mb-0.5">晚高峰峰值</span>
            <span class="font-extrabold text-emerald-600 dark:text-emerald-400">152 MB/s</span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] mb-0.5">平均延迟</span>
            <span class="font-extrabold text-sky-600 dark:text-sky-400">73.8 ms</span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] mb-0.5">部署协议</span>
            <span class="font-extrabold text-indigo-600 dark:text-indigo-400">轻量 VLESS</span>
          </div>
        </div>

        <!-- Plans preview badge -->
        <div class="px-3 py-2 rounded-lg bg-indigo-50/70 dark:bg-indigo-950/40 text-[11px] text-slate-600 dark:text-slate-300 border border-indigo-100 dark:border-indigo-900 flex items-center justify-between flex-wrap gap-1">
          <span><strong>官方全量9大配套：</strong>白银纪元 ¥24/月 (主力) · 星耀风暴 ¥109/年 · 永不过期买断包</span>
          <a href="/airports/invisible-cloud#plans" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">查看全部 9 大配套 &rarr;</a>
        </div>

        <!-- Pricing & Coupon Row -->
        <div class="flex items-center justify-between gap-3 pt-1">
          <div class="flex items-baseline gap-1">
            <span class="text-xs text-slate-400">白银入门仅</span>
            <span class="text-3xl font-black text-rose-600 dark:text-rose-400">¥{airport.price}</span>
            <span class="text-xs text-slate-500 font-medium">{airport.billingCycle}</span>
          </div>

          {airport.couponCode && (
            <button
              type="button"
              class="copy-coupon-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border-2 border-dashed border-amber-400 dark:border-amber-600 hover:bg-amber-100 dark:hover:bg-amber-900 transition-all text-xs font-black cursor-pointer active:scale-95 shadow-sm"
              data-coupon={airport.couponCode}
              data-discount={airport.discount}
              data-name={airport.name}
              title="点击复制优惠码"
            >
              <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>码: {airport.couponCode}</span>
            </button>
          )}
        </div>

          <!-- Big CTA Buttons -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <a
              href={airport.affUrl}
              target="_blank"
              rel="noopener noreferrer nofollow sponsored"
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-black text-sm text-white bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 active:scale-98 shadow-lg shadow-indigo-600/30 transition-all text-center"
            >
              <span>直达官网开通</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/airports/invisible-cloud"
              class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-3 rounded-xl font-black text-sm text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 border-2 border-indigo-200/90 dark:border-indigo-800/90 transition-all text-center shadow-xs"
            >
              <span>本站主推第一详情页面</span>
              <svg class="w-4 h-4 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
      </div>
    </div>
  </div>
) : (
  <!-- STANDARD 4-COLUMN COMPACT CARD (每排4个品牌的框架) -->
  <div
    class="airport-card group relative bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/90 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-indigo-500/40 dark:hover:border-indigo-500/40 transition-all duration-300 flex flex-col justify-between"
    data-line={airport.lineType}
    data-price={airport.price}
    data-tags={JSON.stringify(airport.tags)}
  >
    <!-- Top info -->
    <div>
      <!-- Badges Row -->
      <div class="flex items-center justify-between gap-1.5 mb-2.5 flex-wrap">
        <div class="flex items-center gap-1.5 flex-wrap">
          {airport.badge && (
            <span class={`text-[11px] font-bold px-2 py-0.5 rounded border ${currentBadgeStyle}`}>
              {airport.badge}
            </span>
          )}
          <span class="text-[11px] font-medium px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
            {airport.lineType}
          </span>
        </div>

        <!-- Rating -->
        <div class="flex items-center gap-1 text-[11px] text-slate-500">
          <span class="text-amber-400 font-bold">★ {airport.rating}</span>
        </div>
      </div>

      <!-- Title & Slogan -->
      <div class="mb-3">
        <h3 class="text-lg font-black text-slate-900 dark:text-white tracking-tight group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
          {airport.name}
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 min-h-[32px] leading-relaxed">
          {airport.slogan}
        </p>
      </div>

      <!-- Compact Specs Box -->
      <div class="grid grid-cols-2 gap-2 py-2.5 px-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 mb-3 text-[11px]">
        <div>
          <span class="text-slate-400 block mb-0.5">流量规格</span>
          <span class="font-bold text-slate-700 dark:text-slate-200 truncate block">{airport.traffic}</span>
        </div>
        <div>
          <span class="text-slate-400 block mb-0.5">晚高峰峰值</span>
          <span class="font-bold text-emerald-600 dark:text-emerald-400 truncate block">{airport.speedPeak}</span>
        </div>
      </div>

      <!-- Streaming Unlock Pills -->
      <div class="mb-4">
        <div class="flex flex-wrap gap-1">
          {airport.streaming.slice(0, 3).map((item) => (
            <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-indigo-50 dark:bg-indigo-950/40 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/50">
              ✓ {item}
            </span>
          ))}
          {airport.streaming.length > 3 && (
            <span class="text-[10px] text-slate-400 px-1 py-0.5">+{airport.streaming.length - 3}</span>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom Actions & Price -->
    <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2.5">
      <!-- Price & Coupon -->
      <div class="flex items-center justify-between gap-1 flex-wrap">
        <div class="flex items-baseline gap-0.5">
          <span class="text-[10px] text-slate-400">起步</span>
          <span class="text-xl font-black text-rose-600 dark:text-rose-400">¥{airport.price}</span>
          <span class="text-[10px] text-slate-400">{airport.billingCycle}</span>
        </div>

        {airport.couponCode && (
          <button
            type="button"
            class="copy-coupon-btn inline-flex items-center gap-1 px-2 py-1 rounded-md bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-dashed border-amber-300 dark:border-amber-700 hover:bg-amber-100 dark:hover:bg-amber-900/50 transition-colors text-[11px] font-bold cursor-pointer active:scale-95"
            data-coupon={airport.couponCode}
            data-discount={airport.discount}
            data-name={airport.name}
            title="点击复制优惠码"
          >
            <svg class="w-3 h-3 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>{airport.couponCode}</span>
          </button>
        )}
      </div>

      <!-- Action Button -->
      <a
        href={airport.affUrl}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl font-bold text-xs text-white bg-indigo-600 hover:bg-indigo-700 active:scale-98 shadow-sm shadow-indigo-500/20 transition-all text-center"
      >
        <span>直达官网开通</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
)}
